{
  "name": "ditto-mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ditto-mcp-stdio": "dist/bin/stdio.js",
    "ditto-mcp-http": "dist/bin/http.js",
    "ditto-mcp-ingest": "dist/bin/ingest.js"
  },
  "scripts": {
    "fetch-spec": "node scripts/fetch-ditto-spec.mjs",
    "prebuild": "npm run fetch-spec",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run fetch-spec",
    "test": "vitest run",
    "pretest:watch": "npm run fetch-spec",
    "test:watch": "vitest",
    "test:pg": "vitest run --config vitest.pg.config.ts",
    "predev:stdio": "npm run fetch-spec",
    "dev:stdio": "tsx src/bin/stdio.ts",
    "predev:http": "npm run fetch-spec",
    "dev:http": "tsx src/bin/http.ts",
    "dev:ingest": "tsx src/bin/ingest.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^11.10.0",
    "express": "^4.21.2",
    "pg": "^8.22.0",
    "sqlite-vec": "^0.1.9",
    "yaml": "^2.9.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.20.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
